# Copy to .env (git-ignored) and fill in. Never commit real keys.
# Inference is disabled when APERTUS_API_KEY is empty; keyword search still works.

# CSCS/Keera gateway (development). For the offline proof, point this at a
# local OpenAI-compatible server instead, e.g. http://localhost:8080/v1
APERTUS_BASE_URL=https://gateway.keera.ch/api/v1
APERTUS_API_KEY=

# Bulk extraction/assessment model (architecture step 4) and optional quality model.
# Keera IDs: apertus-v1-5-8b, apertus-v1-5-70b (tool calls); *-thinking (no tool calls).
APERTUS_MODEL=apertus-v1-5-8b
APERTUS_QUALITY_MODEL=apertus-v1-5-70b

# Reliability limits (defaults shown).
APERTUS_TIMEOUT_S=30
APERTUS_MAX_RETRIES=2
APERTUS_BACKOFF_BASE_S=0.5
APERTUS_MAX_CONCURRENCY=4

# Opt-in live tests: BERNMATCH_LIVE_TESTS=1 python -m pytest tests/ai/test_live.py -s
